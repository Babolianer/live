# ── Datenbank (Turso / libSQL) ───────────────────────────────────
# Lokal: leer lassen → nutzt automatisch eine lokale Datei "local.db" im Projektordner.
# Live: URL + Token aus deiner Turso-Datenbank (https://app.turso.tech → Datenbank erstellen → "Connect").
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Dateispeicher (Vercel Blob) ──────────────────────────────────
# Token aus deinem Vercel-Projekt: Storage-Tab → Blob-Store erstellen → ".env.local"-Tab kopieren.
# Wird auf Vercel selbst automatisch gesetzt, sobald der Blob-Store am Projekt hängt — für lokale
# Entwicklung musst du ihn hier von Hand eintragen.
BLOB_READ_WRITE_TOKEN=

# ── OpenRouter (KI) ──────────────────────────────────────────────
# API-Key aus https://openrouter.ai/keys — erforderlich, damit "Ask LIFE" funktioniert.
OPENROUTER_API_KEY=
# Nur kostenlose Modelle (":free"-Suffix, siehe https://openrouter.ai/models?max_price=0).
# Nemotron 3 Ultra: NVIDIA-Flagship-Modell, 1M Tokens Kontext, gut für Reasoning über viele Dokumente.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── App ──────────────────────────────────────────────────────────
# Öffentliche URL der App (wird als HTTP-Referer an OpenRouter gesendet).
# Lokal unverändert lassen, auf Vercel auf die echte Domain setzen (z. B. https://life-app.vercel.app).
APP_URL=http://localhost:3000
