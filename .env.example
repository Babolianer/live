# ── Datenbank (Turso / libSQL) ───────────────────────────────────
# Lokal: leer lassen → nutzt automatisch eine lokale Datei "local.db" im Projektordner.
# Live: URL + Token aus deiner Turso-Datenbank (https://app.turso.tech → Datenbank erstellen → "Connect").
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Dateispeicher (Vercel Blob) ──────────────────────────────────
# Token aus deinem Vercel-Projekt: Storage-Tab → Blob-Store erstellen → ".env.local"-Tab kopieren.
# Wird auf Vercel selbst automatisch gesetzt, sobald der Blob-Store am Projekt hängt — für lokale
# Entwicklung musst du ihn hier von Hand eintragen.
BLOB_READ_WRITE_TOKEN=

# ── Vermögen: Live-Kurse (optional) ──────────────────────────────
# Ohne beide Keys funktioniert der Kurs-Refresh trotzdem (Aktien/ETF über
# Yahoo Finance, Krypto über CoinGecko — beide ohne Key nutzbar, nur mit
# knapperen Rate-Limits). Die Keys hier sind optional bessere Datenquellen.
# Massive API (https://massive.com) für Aktien/ETF-Kurse.
MASSIVE_API_KEY=
# FreeCryptoAPI (https://freecryptoapi.com) als Krypto-Fallback, falls CoinGecko rate-limited.
FREECRYPTOAPI_KEY=

# ── Groq (KI) ─────────────────────────────────────────────────────
# Kostenloser API-Key aus https://console.groq.com/keys — erforderlich, damit
# "Ask LIFE" funktioniert. Groq's Free-Tier hat pro Modell ein eigenes,
# grosszügiges Kontingent (keine geteilte Tages-Sperre über alle Modelle wie
# bei OpenRouters ":free"-Modellen).
GROQ_API_KEY=
# Llama 3.3 70B: schnelles, starkes Allround-Modell mit gutem Tool-Calling.
GROQ_MODEL=llama-3.3-70b-versatile
# Modell für Chat-Nachrichten mit Bild-Anhang (muss Vision/Bild-Input unterstützen).
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── App ──────────────────────────────────────────────────────────
# Öffentliche URL der App (wird als HTTP-Referer an OpenRouter gesendet).
# Lokal unverändert lassen, auf Vercel auf die echte Domain setzen (z. B. https://life-app.vercel.app).
APP_URL=http://localhost:3000
